APP_NAME=Stayflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Per OQ-06: locales we support = id, en, zh.
APP_SUPPORTED_LOCALES=id,en,zh

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# For native dev (XAMPP/Laragon etc.) keep DB_HOST=127.0.0.1.
# For Sail dev, override DB_HOST=mysql in .env.sail (used by `make setup`).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stayflow
DB_USERNAME=root
DB_PASSWORD=

# --- Concurrency suite (task P1-10, docs/CONCURRENCY.md) ---------------------
# The concurrency suite needs a real MySQL 8 server: SQLite serializes writes
# and would hide every race the suite exists to catch. It uses a dedicated
# database, so it can rebuild its schema without touching the data above.
#
# CONCURRENCY_TESTS:
#   auto     (default) run the suite when the server answers, skip otherwise
#   1        the suite is required: a missing server fails the build
#   0        the suite is disabled
CONCURRENCY_TESTS=auto
CONCURRENCY_DB_HOST=127.0.0.1
CONCURRENCY_DB_PORT=3307
CONCURRENCY_DB_DATABASE=stayflow_concurrency
CONCURRENCY_DB_USERNAME=root
CONCURRENCY_DB_PASSWORD=
# Number of worker processes used by the concurrency scenarios. Each worker
# is an independent PHP process with its own MySQL session.
CONCURRENCY_WORKERS=24

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# --- Redis -----------------------------------------------------------------
# For Sail dev, override REDIS_HOST=redis in .env.sail.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ------------------------------------------------------------------
# For Sail dev, override MAIL_HOST=mailpit and MAIL_PORT=1025 in .env.sail.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@stayflow.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (S3-compatible, MinIO in dev) -------------------------
# For Sail dev, override AWS_ENDPOINT=http://minio:9000 in .env.sail.
AWS_ACCESS_KEY_ID=stayflow
AWS_SECRET_ACCESS_KEY=stayflow-dev-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=stayflow-local
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=

# --- Error tracking (Sentry) -----------------------------------------------
# Leave SENTRY_LARAVEL_DSN empty in local dev to disable remote reporting.
# The PiiScrubber in App\Support\Helpers redacts emails, phone numbers and
# credential assignments regardless of this flag; SENTRY_SEND_DEFAULT_PII is
# forced false in config/sentry.php.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

VITE_APP_NAME="${APP_NAME}"