APP_NAME=Stayflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Per OQ-06: locales we support = id, en, zh.
APP_SUPPORTED_LOCALES=id,en,zh

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# For native dev (XAMPP/Laragon etc.) keep DB_HOST=127.0.0.1.
# For Sail dev, override DB_HOST=mysql in .env.sail (used by `make setup`).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stayflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# --- Redis -----------------------------------------------------------------
# For Sail dev, override REDIS_HOST=redis in .env.sail.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ------------------------------------------------------------------
# For Sail dev, override MAIL_HOST=mailpit and MAIL_PORT=1025 in .env.sail.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@stayflow.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (S3-compatible, MinIO in dev) -------------------------
# For Sail dev, override AWS_ENDPOINT=http://minio:9000 in .env.sail.
AWS_ACCESS_KEY_ID=stayflow
AWS_SECRET_ACCESS_KEY=stayflow-dev-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=stayflow-local
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"